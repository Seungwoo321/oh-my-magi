{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAGI CONSOLE",
  "version": "0.1.0",
  "identifier": "dev.ohmymagi.console",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bash scripts/build-codex-acp.sh --require-signature \"${TAURI_ENV_ARCH:?}\" && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MAGI COMMAND CONSOLE",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "companion",
        "title": "MAGI CONSOLE",
        "width": 440,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "resources": {
      "../.local/provider-build/codex-http-ca-preserve-backend-v1-package/codex-acp-tauri-resources/": "provider/codex-acp/",
      "../.local/native-build/extraction/": "extraction/",
      "../docs/SECURITY.md": "policy/SECURITY.md",
      "../src/assets/fonts/barlow-condensed/OFL.txt": "licenses/fonts/barlow-condensed/OFL.txt",
      "../src/assets/fonts/noto-sans-kr/OFL.txt": "licenses/fonts/noto-sans-kr/OFL.txt",
      "../NOTICE.md": "licenses/NOTICE.md",
      "../LICENSE": "licenses/LICENSE",
      "../src/assets/fonts/ibm-plex-mono/OFL.txt": "licenses/fonts/ibm-plex-mono/OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NUE2ODgwMkRBQkRBOUQKUldTZDJxc3RnR2hhU0xmK1UydElmMXRYR2c0Z1hOQ1VjYzg3elQ3SXkrMERnU0JqU1F4WXkxbWMK",
      "endpoints": [
        "https://github.com/Seungwoo321/oh-my-magi/releases/latest/download/release-manifest.json"
      ]
    }
  }
}
